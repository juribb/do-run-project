# 이 파일을 복사해서 .env로 만들고 실제 값을 채워 넣으세요.
# .env는 .gitignore에 이미 포함되어 있어 저장소에 올라가지 않습니다.

# Kakao Developers > 내 애플리케이션 > 앱 키 > 네이티브 앱 키
EXPO_PUBLIC_KAKAO_NATIVE_APP_KEY=

# Kakao Developers > 앱 키 > JavaScript 키
# 앱 코드에서 직접 쓰진 않는다 — running-course-map-web 저장소의 지도 페이지에 박혀 있다.
# 여기 적어두는 건 기록용. 도메인 등록으로 보호되는 값이라 노출돼도 안전하다.
EXPO_PUBLIC_KAKAO_JS_KEY=

# Supabase 프로젝트 > Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
